<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Agentes rodando no terminal embutido (ditado do Claude Code, por exemplo)
       pedem o microfone em nome do Bando. Com hardened runtime, sem esta chave
       o macOS nega o acesso sem perguntar. -->
  <key>com.apple.security.device.audio-input</key><true/>
</dict>
</plist>
